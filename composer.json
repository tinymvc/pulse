{
    "name": "tinymvc/pulse",
    "description": "Monitor TinyMVC Spark application activity, performance, and runtime events.",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*",
        "tinymvc/tinycore": "^4.2.16 || dev-main"
    },
    "autoload": {
        "psr-4": {
            "Spark\\Pulse\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php tests/run.php"
    },
    "authors": [
        {
            "name": "Shahin Moyshan",
            "email": "shahin.moyshan2@gmail.com"
        }
    ],
    "archive": {
        "exclude": [
            "/vendor",
            "/tests",
            "/composer.lock",
            "/.gitignore",
            "/.gitattributes",
            ".DS_Store"
        ]
    }
}
